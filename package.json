{
  "name": "break-in-different",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-secrets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p convex --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "MOCK_AI=1 playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "doctor": "node scripts/doctor.mjs",
    "test:integration": "node tests/integration/security.mjs",
    "test:agent": "cd agent && .venv/bin/pytest -q",
    "seed": "npx convex run seed:demo",
    "ingest": "npx convex run ingest/run:run",
    "demo": "./scripts/demo.sh up",
    "demo:reset": "./scripts/demo.sh reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "convex": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jose": "^6.2.13",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
