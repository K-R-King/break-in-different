# Template for .env (sponsor API keys). Copy to .env and fill in locally. Never commit .env.
# These are pushed into the Convex server environment by ./scripts/demo.sh up (deploy step).
# They never reach the browser bundle or the MatchAgent. Leave a value empty to use its fallback.

# Anthropic Claude (resume + listing extraction, match explanations, email drafts)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_EXTRACT=claude-haiku-5-5
CLAUDE_MODEL_WRITE=claude-sonnet-5-5

# Cartesia (read-aloud TTS with word timestamps; speech-to-text for voice commands and dictation)
CARTESIA_API_KEY=
# Optional: any Cartesia voice ID; empty uses the default voice
CARTESIA_VOICE_ID=

# Apify (job collection via the Store Actor bovi/greenhouse-lever-ashby-job-scraper)
APIFY_TOKEN=
# Set to 1 to run the daily scheduled scrape (12:00 UTC). Empty: off, so demo data stays fixed.
# Manual scrapes still work either way: npm run ingest, ./scripts/build-seed.sh
SCHEDULED_INGEST=

# Set to 1 to force every fallback (deterministic tests); leave empty for real integrations
MOCK_AI=
