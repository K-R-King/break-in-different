# Local development (npm run dev). Values live in .env.local, which is never committed.
# Self-hosted Convex (Docker): get the admin key with ./scripts/demo.sh admin-key
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
VITE_CONVEX_URL=http://127.0.0.1:3210
# Server-side keys are set with `npx convex env set NAME value`, never here:
# ANTHROPIC_API_KEY, CLAUDE_MODEL_EXTRACT, CLAUDE_MODEL_WRITE, CARTESIA_API_KEY, CARTESIA_VOICE_ID,
# APIFY_TOKEN, AGENT_SHARED_SECRET, JWT_PRIVATE_KEY, JWKS, SITE_URL
