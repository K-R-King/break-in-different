# Template for .env.docker (infrastructure secrets, generated by ./scripts/demo-docker.sh init). Never commit .env.docker.
# Sponsor API keys do NOT go here: put them in .env (see .env.example).
CONVEX_INSTANCE_SECRET=
CONVEX_SELF_HOSTED_ADMIN_KEY=
AGENT_SHARED_SECRET=
# Host the browser uses to reach the app (server IP or DNS name). Leave empty for same-machine use (127.0.0.1).
PUBLIC_HOST=
# Live site behind an HTTPS proxy (e.g. Caddy): public URLs for the Convex API (proxy to :3210), Convex HTTP actions
# (proxy to :3211) and the app (proxy to :8080), e.g. https://api.example.com. Leave empty to derive them from PUBLIC_HOST (http://<host>:3210 and :3211, app on :8080).
CONVEX_URL=
CONVEX_SITE_URL=
SITE_URL=
# 127.0.0.1 publishes 3210, 3211, 6791 and 8080 only to this machine (the proxy); empty means all interfaces.
BIND_IP=
